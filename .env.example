# Supabase: Project Settings > API. URL-д зам бүү нэм. Шинэ publishable/secret түлхүүр ч ажиллана.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# НУУЦ: зөвхөн сервер дээр. Хэзээ ч олон нийтэд бүү түгээ.
SUPABASE_SERVICE_ROLE_KEY=

# Анхны тохиргоо (scripts/setup.mjs)
ORG_NAME=Манай компани
ADMIN_NAME=Админ
ADMIN_PHONE=утасны дугаар
